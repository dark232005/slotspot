# ==========================================
# SlotSpot SaaS Environment Configuration
# ==========================================

# Database:
# For local zero-setup fallback (Default):
DATABASE_URL=sqlite:///./slotspot.db
# For PostgreSQL via Docker or native installation:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slotspot

# Authentication & Security
SECRET_KEY=change-this-to-a-secure-random-32-byte-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# No-Show Worker Grace Period Configuration (Minutes)
DEFAULT_NO_SHOW_GRACE_MINUTES=10
NO_SHOW_CHECK_INTERVAL_SECONDS=15

# Frontend Vite API URL (Optional override)
VITE_API_URL=http://localhost:8000/api/v1
